# Superpowers working docs (local only, not committed)
docs/superpowers/
.superpowers/
.claude/worktrees/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# src/seaminerator/_vendor/ is committed on purpose: it is the add-on's
# vendored runtime dependency (httpx and its transitive deps), and an
# .ankiaddon has no install step, so the source must travel with the repo.
# dist/ (ignored above) holds the *built* .ankiaddon zip, which is
# regenerated by scripts/build.sh and never committed.

# Tooling / caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local config & secrets
.env
*.local.toml

# Anki writes this into the add-on folder the first time config is saved
# from Tools -> Add-ons -> Config. It's a generated per-install artifact,
# not source. Only appears here for developers using the docs/development.md
# directory-junction workflow, where src/seaminerator/ IS the add-on folder.
src/seaminerator/meta.json

# Local scratch files (manual testing, not part of the project)
scratch_*.py

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
